{
  "name": "astrotopia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "format": "prettier --write src tests *.ts *.json index.html README.md docs/*.md",
    "dev:client": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "dev:server": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx server/index.ts",
    "test:online": "vitest run tests/online.test.ts tests/online-persistence.test.ts --maxWorkers=1",
    "backup:server": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx server/backup.ts",
    "test:online:browser": "playwright test --config playwright.online.config.ts"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.2",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
