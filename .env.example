# Local development only. Copy to .env; never commit real environment files.
# Exact frontend origin(s), comma separated; wildcard origins are not accepted.
APP_ORIGIN=http://127.0.0.1:5180
# APP_DOMAIN=  # Optional domain; APP_ORIGIN supplies the canonical scheme/port.
VITE_COOP_ORIGIN=http://127.0.0.1:5190
COOP_HOST=127.0.0.1
COOP_PORT=5190
COOP_DATABASE=server/data/worlds.sqlite
# NODE_ENV=production refuses to start until production authentication exists.
